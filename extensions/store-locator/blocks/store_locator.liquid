{%- liquid
  assign frame_url = routes.root_url | append: '/apps/locator/frame' | replace: '//', '/'
-%}
<div
  class="findly-store-locator"
  style="max-width: {{ block.settings.max_width }}px; margin: {{ block.settings.spacing }}px auto;"
  {{ block.shopify_attributes }}
>
  {%- if block.settings.heading != blank -%}
    <h2 class="findly-store-locator__heading">{{ block.settings.heading | escape }}</h2>
  {%- endif -%}
  <iframe
    src="{{ frame_url }}"
    title="{{ block.settings.heading | default: 'Store locator' | escape }}"
    allow="geolocation"
    loading="lazy"
    style="display: block; width: 100%; height: {{ block.settings.height }}px; border: 0; border-radius: {{ block.settings.radius }}px;"
  ></iframe>
</div>

{% schema %}
{
  "name": "Store locator",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Optional. The locator also has its own heading, set in the app."
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height",
      "min": 400,
      "max": 1000,
      "step": 20,
      "unit": "px",
      "default": 640
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum width",
      "min": 600,
      "max": 2000,
      "step": 20,
      "unit": "px",
      "default": 1400
    },
    {
      "type": "range",
      "id": "radius",
      "label": "Corner radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "spacing",
      "label": "Vertical spacing",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 24
    }
  ]
}
{% endschema %}
