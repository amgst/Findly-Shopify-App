# Copy this file to ".env" and fill in your values. Never commit .env.

# ---- Database (Postgres) ----
# Vercel Prisma Postgres: added automatically (use the postgres:// DATABASE_URL).
# Supabase: Connect → ORMs → Prisma (session pooler, port 5432).
DATABASE_URL="postgres://USER:PASSWORD@HOST:5432/postgres"

# ---- Web dashboard logins ----
# Any long random string. Required in production.
SESSION_SECRET="change-me-to-a-long-random-string"
