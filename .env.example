# Existing application credentials and database settings must be filled locally.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=https://findly-store-finder.vercel.app
SESSION_SECRET=
DATABASE_URL=
SCOPES=read_locations

# Optional private Google Sheets connections (server-side only).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Stable random secret, at least 32 characters, used to encrypt Google refresh tokens.
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Shopify App Pricing ? server only. Manage apps permission is required.
# Partner ID from partners.shopify.com, not the Dev Dashboard organization ID.
SHOPIFY_PARTNER_ORG_ID=719655
SHOPIFY_PARTNER_API_ACCESS_TOKEN=
# Numeric app ID from the Partner Dashboard, NOT the app client_id.
SHOPIFY_APP_GID=gid://shopify/App/441377488897
# App handle used in Shopify's /charges/{handle}/pricing_plans URL.
SHOPIFY_APP_HANDLE=
